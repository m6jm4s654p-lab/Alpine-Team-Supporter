{
  "name": "Alpine Team Supporter",
  "short_name": "Team Supporter",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#081019",
  "theme_color": "#118447",
  "lang": "ja",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./supporter-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./supporter-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".atsdata",
          ".json"
        ]
      }
    }
  ]
}